# 构建产物
build/
build-*/
dist/
out/

# 打包工具的下载缓存(NSIS 免安装版)与一次性探针
.tools/

# Qt 生成物
*.pro.user
*.pro.user.*
moc_*.cpp
qrc_*.cpp
ui_*.h
*.qm

# 编译中间件
*.o
*.obj
*.a
*.lib
*.exp
*.pdb
*.ilk
*.exe
*.dll
!packaging/**/*.dll

# Python 缓存(tools/ 下的脚本用 py_compile 检查过语法就会留下)
__pycache__/
*.pyc

# 编辑器 / 系统
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# AI 助手的工作目录(记忆、技能缓存),属于本机状态,不进仓库
.workbuddy-ai/

# 一次性探针编译出来的可执行文件(tools/*/ 里的 .cpp 保留,产物忽略)
tools/*/*.exe
